APP_ENV=production
JWT_KEY=replace-with-a-long-random-value
SQLX_SQLITE_DSN=file:/data/sqlite/bbtkru.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)
CORS_ALLOWED_ORIGINS=https://fairintern.com,https://www.fairintern.com

# Litestream credentials. Keep real values only in backend/.env.
LITESTREAM_ACCESS_KEY_ID=replace-with-yandex-access-key-id
LITESTREAM_SECRET_ACCESS_KEY=replace-with-yandex-secret-access-key
